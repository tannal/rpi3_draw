---
# 基础风格
BasedOnStyle: LLVM

# 语言版本
Standard: Cpp11

# 缩进宽度（嵌入式通常使用 4 空格）
IndentWidth: 4
TabWidth: 4
UseTab: Never

# 每行最大长度（建议 100，方便分屏看代码）
ColumnLimit: 100

# 指针和引用的对齐（推荐靠右：int *ptr; 符合 C 语言逻辑）
PointerAlignment: Right

# 大括号换行策略
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Never
  AfterEnum: true
  AfterFunction: true        # 函数名和左大括号换行，方便在搜索函数定义
  AfterNamespace: false
  AfterStruct: false         # 结构体不换行，保持紧凑
  AfterUnion: false
  BeforeCatch: true
  BeforeElse: false          # else 紧跟在 } 后面
  IndentBraces: false

# 允许短代码块写在同一行
AllowShortBlocksOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false

# 对齐配置（让代码像表格一样整齐）
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: true   # 连续赋值符号对齐 (=)
AlignConsecutiveDeclarations: true   # 连续变量声明对齐
AlignOperands: true
AlignTrailingComments: true          # 行尾注释对齐（非常适合标注寄存器）

# 空格配置
SpaceAfterCStyleCast: true           # 强制类型转换后加空格 (int) x
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements # 只有 if/for/while 后加空格

# 排序头文件（防止包含顺序混乱）
SortIncludes: true

# 结构体初始化列表对齐
Cpp11BracedListStyle: true
...